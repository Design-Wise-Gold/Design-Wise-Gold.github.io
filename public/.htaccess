# ──────────────────────────────────────────────────────────────────────
# WiseGold Capital - Server Configuration
# Handles Custom 404 and Pretty URLs for Apache Servers
# ──────────────────────────────────────────────────────────────────────

# 1. Custom 404 Page
# Points to the generated 404.html from Astro
ErrorDocument 404 /404.html

# 2. Pretty URLs (Remove .html extension)
RewriteEngine On
RewriteBase /

# Force trailing slash on directories (Optional but recommended for consistency)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# If the request is not a real file or directory, try adding .html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]

# 3. Security: Disable directory browsing
Options -Indexes

# 4. Handle index.html inside folders automatically
DirectoryIndex index.html

# 5. Browser Caching (Lighthouse / PageSpeed Optimization)
# ──────────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # Hashed Astro Assets (Media, CSS, JS) - Cache for 1 Year
    # These files are fingerprinted (e.g. video.CtXvdvTx.mp4) and never change
    <FilesMatch "\.(mp4|webm|css|js|woff2|woff|ttf|otf|svg|png|jpg|jpeg|gif|ico)$">
        ExpiresDefault "access plus 1 year"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML files - Do not cache (check for changes every time)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 6. Gzip Compression (Performance Enhancement)
# ──────────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>
