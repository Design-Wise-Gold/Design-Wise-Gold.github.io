---
import Card__Model from "./molecules/card__model.astro";
---

<section
    id="model"
    class="flex flex-col items-center justify-center h-full lg:py-24 w-full pt-8 pb-10 gap-6 bg-black-900"
>
    <article
        class="w-full h-auto flex flex-col items-center justify-center gap-2 px-4"
    >
        <h2
            class="text-4xl md:text-5xl font-medium text-white-700 uppercase font-bebas-neue leading-tight lg:leading-14 mt-2 text-left lg:text-center w-full"
        >
            INVENTORY STRUCTURE

            <span class="text-accent">Two Complementary Models </span>
        </h2>
        <p
            class="text-gray-300 lg:mt-3 text-sm md:text-base text-left lg:text-center w-full lg:w-2/3"
        >
            Holdings may be converted from Consolidated to Assigned Inventory at
            any time, subject to prevailing market conditions and logistics.
        </p>
    </article>
    <article
        id="model-cards"
        class="w-full flex flex-col lg:flex-row items-end px-4 justify-center gap-4 lg:min-h-[400px]"
    >
        <Card__Model
            title="Assigned Inventory"
            description="Client-directed holdings with product, jurisdiction, and vault specificity."
            item1="Direct association with specific bullion products"
            item2="Maximum control and transparency"
            item3="Suitable for clients requiring precise allocation"
            item4="Ideal for investors prioritizing customization"
        />
        <Card__Model
            title="Consolidated Inventory"
            description="System-managed allocation designed for efficiency and diversification."
            item1="Ownership recorded at the account level"
            item2="Fully backed by underlying bullion inventory"
            item3="Automatic jurisdictional diversification"
            item4="Optimized transaction spreads and liquidity"
        />
    </article>
</section>
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const initRiskPinnedAnimation = () => {
            const riskSection = document.querySelector("#model");
            const headers = document.querySelectorAll("#model h2, #model p");
            const cards = gsap.utils.toArray("#model-cards > *");

            if (!riskSection || cards.length === 0) return;

            // Headers enter early to fill the gap
            gsap.fromTo(
                headers,
                { opacity: 0, y: 30 },
                {
                    opacity: 1,
                    y: 0,
                    stagger: 0.1,
                    duration: 0.5,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: riskSection,
                        start: "top 95%",
                        toggleActions: "play none none reverse",
                    },
                },
            );

            // Cards follow sequentially with pinning
            const mainTl = gsap.timeline({
                scrollTrigger: {
                    trigger: riskSection,
                    start: "top top",
                    pin: true,
                    scrub: 1,
                    invalidateOnRefresh: true,
                },
            });

            cards.forEach((card, i) => {
                const startTime = i * 0.4;
                mainTl.fromTo(
                    card,
                    { opacity: 0, y: 100 },
                    { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" },
                    startTime,
                );
            });

            mainTl.to({}, { duration: 0.5 });
            ScrollTrigger.refresh();
        };

        initRiskPinnedAnimation();
        window.addEventListener("load", () => ScrollTrigger.refresh());
        setTimeout(() => ScrollTrigger.refresh(), 1000);
    });
</script>
