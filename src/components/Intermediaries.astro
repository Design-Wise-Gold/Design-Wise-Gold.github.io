---
const endpoint = "/api/api.php?action=submit"; 
---

<section
    id="intermediaries"
    class="flex flex-col lg:flex-row items-start justify-between h-auto w-full lg:p-12 lg:pt-16 gap-8 lg:gap-12 max-w-screen border-t-[0.2px] border-gray-500"
>
    <div
        class="flex flex-col lg:flex-row bg-accent w-full h-full md:min-h-dvh lg:min-h-full md:justify-between lg:justify-start lg:rounded-4xl px-4 pt-12 pb-8 lg:p-12 gap-8 lg:gap-40"
    >
        <!-- Left Column: Header + Form -->
        <div class="flex flex-col justify-between w-full lg:w-3/5 h-full gap-8">
            <!-- Header -->
            <article
                class="w-full flex flex-col items-start justify-center gap-2 lg:gap-0"
            >
                <h4
                    class="text-3xl md:text-4xl font-medium text-center lg:text-left text-black-900 uppercase font-bebas-neue leading-tight lg:leading-14"
                >
                    A Platform Built for Professional Distribution
                </h4>
                <p
                    class="text-gray-900 text-base w-full lg:w-4/5 text-center lg:text-left"
                >
                    WiseGold Capital operates exclusively through approved intermediaries.
                </p>
            </article>

            <!-- Contact Form -->
            <form
                id="intermediaries-form"
                action={endpoint}
                method="POST"
                class="w-full h-full flex flex-col justify-between gap-5 p-6 rounded-2xl bg-amber-200"
            >
                <div
                    class="flex flex-col lg:flex-row lg:items-center gap-1 lg:gap-4"
                >
                    <label
                        for="legal-name"
                        class="text-black-900 text-xs font-bold uppercase lg:w-48 shrink-0"
                        >Legal Name of Firm</label
                    >
                    <input
                        type="text"
                        name="legal-name"
                        id="legal-name"
                        autocomplete="legal-name"
                        required
                        placeholder="Enter legal name..."
                        class="bg-transparent border-b-2 border-black-900/30 text-black-900 placeholder-black-900/50 text-sm py-2 outline-none focus:border-black-900 transition-colors w-full"
                    />
                </div>
                <div
                    class="flex flex-col lg:flex-row lg:items-center gap-1 lg:gap-4"
                >
                    <label
                        for="primary-contact"
                        class="text-black-900 text-xs font-bold uppercase lg:w-48 shrink-0"
                        >Primary Contact Name</label
                    >
                    <input
                        type="text"
                        name="primary-contact"
                        id="primary-contact"
                        autocomplete="primary-contact"
                        required
                        placeholder="Enter primary contact name..."
                        class="bg-transparent border-b-2 border-black-900/30 text-black-900 placeholder-black-900/50 text-sm py-2 outline-none focus:border-black-900 transition-colors w-full"
                    />
                </div>
                <div
                    class="flex flex-col lg:flex-row lg:items-center gap-1 lg:gap-4"
                >
                    <label
                        for="business-email"
                        class="text-black-900 text-xs font-bold uppercase lg:w-48 shrink-0"
                        >Business Email</label
                    >
                    <input
                        type="email"
                        name="business-email"
                        id="business-email"
                        autocomplete="business-email"
                        required
                        placeholder="Enter business email..."
                        class="bg-transparent border-b-2 border-black-900/30 text-black-900 placeholder-black-900/50 text-sm py-2 outline-none focus:border-black-900 transition-colors w-full"
                    />
                </div>
                <div
                    class="flex flex-col lg:flex-row lg:items-center gap-1 lg:gap-4"
                >
                    <label
                        for="phone-number"
                        class="text-black-900 text-xs font-bold uppercase lg:w-48 shrink-0"
                        >Phone Number</label
                    >
                    <input
                        type="tel"
                        name="phone-number"
                        id="phone-number"
                        autocomplete="phone-number"
                        required
                        placeholder="Enter phone number..."
                        class="bg-transparent border-b-2 border-black-900/30 text-black-900 placeholder-black-900/50 text-sm py-2 outline-none focus:border-black-900 transition-colors w-full"
                    />
                </div>
                <!-- Submit Button -->
                <div
                    class="flex justify-center w-full lg:w-fit lg:justify-end mt-12"
                >
                    <button
                        type="submit"
                        class="flex items-center justify-center gap-4 bg-black-900 text-accent py-3 px-8 w-full lg:w-fit hover:bg-gray-900 transition-colors duration-300"
                    >
                        <span class="text-sm font-medium"
                            >Apply for Intermediary Access</span
                        >
                        <svg
                            class="w-5"
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M11 9a1 1 0 0 0 1-1V5.061a1 1 0 0 1 1.811-.75l6.836 6.836a1.207 1.207 0 0 1 0 1.707l-6.836 6.835a1 1 0 0 1-1.811-.75V16a1 1 0 0 0-1-1H9a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1z"
                            ></path>
                            <path d="M4 9v6"></path>
                        </svg>
                    </button>
                </div>
            </form>
        </div>

        
        <div
            class="flex flex-col w-full lg:w-2/5 justify-between lg:py-12 gap-6"
        >
            
            <article class="border border-black-900/30 p-5 flex flex-col gap-2 rounded-lg">
                <h3 class="text-black-900 font-bold text-sm">
                    Intermediaries act as:
                </h3>
                <ul
                    class="text-black-900/70 text-sm flex flex-col gap-1 list-disc list-inside"
                > 
                    <li>Client originators</li>
                    <li>Relationship managers</li>
                    <li>Strategic advisors</li>
                    <li>Facilitators of bullion ownership</li>
                </ul>
            </article>         
            <article class="border-2 border-gray-500 p-5 flex flex-col gap-2 rounded-lg">
                <h3 class="text-black-900 font-bold text-sm">
                    
The platform provides:
                </h3>
                <ol
                    class="text-black-900/70 text-sm flex flex-col gap-1 list-decimal list-inside"
                >
                    <li>Access to global custody infrastructure</li>
                    <li>Structured inventory models</li>
                    <li>Transaction coordination and reporting systems</li>
                    <li>Recurring revenue participation through spreads and custody relationships</li>
                </ol>
            </article>
        </div>
    </div>
</section>

<!-- ReCaptcha v3 Script -->
<script
    is:inline
    src={`https://www.google.com/recaptcha/api.js?render=${import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY}`}
></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.querySelector(
            "#intermediaries-form",
        ) as HTMLFormElement;

        if (form) {
            form.addEventListener("submit", async (e) => {
                e.preventDefault(); // Evitamos recarga de página

                const submitBtn = form.querySelector(
                    'button[type="submit"]',
                ) as HTMLButtonElement;
                const originalBtnText = submitBtn.innerHTML;

                // Estado de carga (opcional pero recomendado)
                submitBtn.disabled = true;
                submitBtn.innerHTML =
                    '<span class="text-sm font-medium">Verifying...</span>';

                try {
                    // @ts-ignore
                    grecaptcha.ready(function () {
                        // @ts-ignore - Reemplaza con tu clave pública
                        grecaptcha
                            .execute(
                                import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY,
                                { action: "submit" },
                            )
                            .then(async function (token: string) {
                                // Recopilar los datos del formulario de manera segura
                                const formData = new FormData(form);
                                const formJSON = Object.fromEntries(
                                    formData.entries(),
                                );

                                // Enviar el token Y los datos al backend (PHP)
                                try {
                                    // 👇 Usamos form.action para mantener consistencia con la variable 'endpoint'
                                    const response = await fetch(
                                        form.action,
                                        {
                                            method: "POST",
                                            headers: {
                                                "Content-Type":
                                                    "application/json",
                                            },
                                            body: JSON.stringify({
                                                recaptcha: token,
                                                data: formJSON,
                                            }),
                                        },
                                    );

                                    const result = await response.json();

                                    if (response.ok && result.success) {
                                        // ÉXITO: El backend validó que es humano y procesó los datos
                                        submitBtn.innerHTML =
                                            '<span class="text-sm font-medium">Application Sent ✓</span>';
                                        submitBtn.classList.replace(
                                            "bg-black-900",
                                            "bg-green-600",
                                        );
                                        submitBtn.classList.replace(
                                            "text-accent",
                                            "text-white",
                                        );
                                        form.reset();

                                        // Restaurar el botón después de 3 segundos
                                        setTimeout(() => {
                                            submitBtn.innerHTML =
                                                originalBtnText;
                                            submitBtn.classList.replace(
                                                "bg-green-600",
                                                "bg-black-900",
                                            );
                                            submitBtn.classList.replace(
                                                "text-white",
                                                "text-accent",
                                            );
                                            submitBtn.disabled = false;
                                        }, 3000);
                                    } else {
                                        // ERROR: Probable bot o error de validación
                                        alert(
                                            "Security check failed or error occurred: " +
                                                (result.message ||
                                                    "Unknown error"),
                                        );
                                        submitBtn.innerHTML = originalBtnText;
                                        submitBtn.disabled = false;
                                    }
                                } catch (error) {
                                    console.error(
                                        "Error submitting form:",
                                        error,
                                    );
                                    alert(
                                        "Failed to connect to the server. Please try again.",
                                    );
                                    submitBtn.innerHTML = originalBtnText;
                                    submitBtn.disabled = false;
                                }
                            });
                    });
                } catch (error) {
                    console.error("reCAPTCHA failed to load:", error);
                    alert(
                        "reCAPTCHA failed to load. Please disable ad-blockers and try again.",
                    );
                    submitBtn.innerHTML = originalBtnText;
                    submitBtn.disabled = false;
                }
            });
        }
    });

    // Cinematic Entrance Animations
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const mm = gsap.matchMedia();

        mm.add("(min-width: 1px)", () => {
            // Section container entrance (Smooth Scale/Fade)
            gsap.from("#intermediaries > div", {
                opacity: 0,
                scale: 0.98,
                duration: 1.5,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#intermediaries",
                    start: "top 85%",
                    toggleActions: "play none none reverse",
                },
            });

            // Headers Reveal
            gsap.from("#intermediaries h4, #intermediaries p", {
                opacity: 0,
                y: 30,
                stagger: 0.2,
                duration: 1,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: "#intermediaries",
                    start: "top 80%",
                    toggleActions: "play none none reverse",
                },
            });

            // Form Fields Staggered Reveal
            gsap.from("#intermediaries-form > div", {
                opacity: 0,
                y: 20,
                stagger: 0.1,
                duration: 1,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#intermediaries-form",
                    start: "top 85%",
                    toggleActions: "play none none reverse",
                },
            });

            // Right-side Info Articles Sequence
            gsap.from("#intermediaries article.border", {
                opacity: 0,
                x: 30,
                stagger: 0.2,
                duration: 1.2,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: "#intermediaries .lg\\:w-2\\/5",
                    start: "top 85%",
                    toggleActions: "play none none reverse",
                },
            });
        });
    });
</script>
