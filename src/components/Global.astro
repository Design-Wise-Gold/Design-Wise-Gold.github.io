---
import Card__global from "./card__global.astro";
---

<section
    id="global"
    class="relative z-20 flex flex-col-reverse lg:flex-row items-start lg:items-center justify-center h-auto w-full border-solid border-gray-500 border-t-[0.2px] py-8 lg:py-24 gap-4 lg:gap-8 bg-black-900"
>
    <article
        id="global-cards"
        class="w-full lg:w-auto flex flex-col items-center justify-center gap-4"
    >
        <Card__global
            number="01"
            title="Advisory"
            description="Provides institutional‑grade consulting on bullion programs, operational design, and governance frameworks for intermediaries and their clients"
        />
        <Card__global
            number="02"
            title="Vault"
            description="Coordinates custody with independent approved depositories, ensuring account‑level segregation, no commingling, and clear ownership at all times"
        />
        <Card__global
            number="03"
            title="Technology"
            description="Delivers the infrastructure that routes instructions, reconciles positions, and provides reporting, without holding client funds or assets"
        />
        <Card__global
            number="04"
            title="Proprietary Trading"
            description="Executes market activity strictly with WiseGold capital, supporting liquidity and discipline without using client assets or acting as a retail broker"
        />
    </article>
    <article
        id="global-header"
        class="w-auto lg:w-2/3 h-auto pt-3 flex flex-col items-center lg:items-right px-4 justify-end lg:pl-32"
    >
        <h2
            class="text-4xl w-full md:text-5xl font-medium text-white-700 uppercase font-bebas-neue leading-tight lg:leading-14 mt-2 text-left lg:text-right"
        >
            <span class="text-accent">Worldwide Depository</span>  & Counterparty Framework
        </h2>
        <p
            class="text-gray-400 lg:mt-3 text-sm md:text-base text-left lg:text-right w-full"
        >
            Strategic access to independent depositories, logistics routes, and
            institutional counterparties across key jurisdictions
        </p>
    </article>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const initGlobalAnimations = () => {
            // 1. Header reveal (Slide from right)
            gsap.fromTo("#global-header > *", 
                { opacity: 0, x: 30 },
                {
                    opacity: 1,
                    x: 0,
                    stagger: 0.2,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#global-header",
                        start: "top 90%",
                        toggleActions: "play none none reverse"
                    }
                }
            );

            // 2. Cards reveal (Slide from below)
            gsap.fromTo("#global-cards > *", 
                { opacity: 0, y: 40 },
                {
                    opacity: 1,
                    y: 0,
                    stagger: 0.15,
                    duration: 1.2,
                    ease: "expo.out",
                    scrollTrigger: {
                        trigger: "#global-cards",
                        start: "top 90%",
                        toggleActions: "play none none reverse"
                    }
                }
            );

            ScrollTrigger.refresh();
        };

        initGlobalAnimations();
        
        // Essential for sections following large pinned blocks (like Risk)
        window.addEventListener("load", () => ScrollTrigger.refresh());
        setTimeout(() => ScrollTrigger.refresh(), 1200);
    });
</script>

