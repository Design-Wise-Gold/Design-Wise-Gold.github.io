---
import Card__global from "./molecules/card__global.astro";
---

<section
    id="global"
    class="relative z-20 flex flex-col-reverse lg:flex-row items-start lg:items-center justify-center h-auto w-full border-solid border-gray-500 border-t-[0.2px] py-8 lg:py-24 gap-4 lg:gap-8 bg-black-900"
>
    <article
        id="global-cards"
        class="w-full lg:w-auto flex flex-col items-center justify-center gap-4"
    >
        <Card__global
            number="01"
            title="Client"
            description="Clients retain beneficial ownership of bullion, ensuring clarity and control at all times."
        />
        <Card__global
            number="02"
            title="Intermediary"
            description="Intermediaries manage client relationships ensuring consistency alignment to at all times."
        />
        <Card__global
            number="03"
            title="WiseGold Capital"
            description="WiseGold Capital coordinates execution custody reporting with transparency up at all times."
        />
        <Card__global
            number="04"
            title="Independent Depository" 
            description="Independent depositories provides custody, ensuring protections and security at all times."
        />
    </article>
    <article
        id="global-header"
        class="w-auto lg:w-2/3 h-auto pt-3 flex flex-col items-center lg:items-right px-4 justify-end lg:pl-32"
    >
        <h2
            class="text-4xl w-full md:text-5xl font-medium text-white-700 uppercase font-bebas-neue leading-tight lg:leading-14 mt-2 text-left lg:text-right"
        >
            Worldwide Depository<br><span class="text-accent"> Operational Model</span>
        </h2>
        <p
            class="text-gray-400 lg:mt-3 text-sm md:text-base text-left lg:text-right w-full"
        >
            A globally structured model that ensures clear separation of roles across all participants. Clients retain ownership, intermediaries manage relationships, WiseGold Capital coordinates execution and reporting, while independent depositories secure physical custody—delivering transparency, control, and operational integrity at every stage.
        </p>
    </article>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const initGlobalAnimations = () => {
            // 1. Header reveal (Slide from right)
            gsap.fromTo("#global-header > *", 
                { opacity: 0, x: 30 },
                {
                    opacity: 1,
                    x: 0,
                    stagger: 0.2,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#global-header",
                        start: "top 90%",
                        toggleActions: "play none none reverse"
                    }
                }
            );

            // 2. Cards reveal (Slide from below)
            gsap.fromTo("#global-cards > *", 
                { opacity: 0, y: 40 },
                {
                    opacity: 1,
                    y: 0,
                    stagger: 0.15,
                    duration: 0.8,
                    ease: "expo.out",
                    scrollTrigger: {
                        trigger: "#global-cards",
                        start: "top 90%",
                        toggleActions: "play none none reverse"
                    }
                }
            );

            ScrollTrigger.refresh();
        };

        initGlobalAnimations();
        
        // Essential for sections following large pinned blocks (like Risk)
        window.addEventListener("load", () => ScrollTrigger.refresh());
        setTimeout(() => ScrollTrigger.refresh(), 1200);
    });
</script>

