---
const { title, description, video } = Astro.props;
---

<div
    class="group relative flex flex-col-reverse lg:flex-col items-left justify-left gap-2 border border-gray-500 h-auto w-full"
>
    <div class="flex flex-col p-2 px-4 h-auto w-full lg:w-auto">
        <span
            class="text-gray-300 group-hover:text-white font-semibold transition-colors duration-300"
            >{title}</span
        >
        <p
            class="text-gray-400 group-hover:text-gray-300 lg:mt-3 text-sm text-left w-full transition-colors duration-300"
        >
            {description}
        </p>
    </div>
    <video
        src={video}
        autoplay
        muted
        loop
        playsinline
        class="w-full h-32 lg:h-full object-cover"
    >
    </video>
</div>
