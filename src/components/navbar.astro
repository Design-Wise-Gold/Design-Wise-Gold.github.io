<nav
    id="navbar"
    class="flex fixed left-0 right-0 justify-between items-center h-auto w-full border border-gray-500 border-b-[0.2px] bg-black-900 z-50 top-0 pr-4 lg:pr-0 max-w-[1920px] mx-auto"
>
    <a
        id="logo-link"
        href="/"
        class="border-r-0 lg:border-r-[0.2px] border-gray-500"
    >
        <img
            class="w-[143px] px-6 py-4 h-full"
            src={logotipo.src}
            alt="logotipo wisegold"
            id="logo__top"
        />
    </a>

    <ul id="menu-desktop" class="hidden lg:flex gap-6">
        <Item__menu class="menu-item" title="Ecosystem" link="/#ecosystem" />
        <Item__menu class="menu-item" title="Two Models" link="/#model" />
        <Item__menu
            class="menu-item"
            title="Custody & Structure"
            link="/#custody"
        />
         <Item__menu
            class="menu-item"
            title="Operational Structure"
            link="/#structure"
        />
        <Item__menu class="menu-item" title="Risk & Governance" link="/#risk" />
       
        <Item__menu class="menu-item" title="Global Network" link="/#global" />
        <Item__menu
            class="menu-item"
            title="For Intermediaries"
            link="/#intermediaries"
        />
        <Item__menu class="menu-item" title="Blog" link="/blog" />
    </ul>

    <button
        id="portal-toggle"
        class="group text-gray-300 hidden lg:flex items-center gap-2 px-4 h-[46px] py-2 hover:bg-gray-900 hover:text-accent w-fit border-gray-500 border-l-[0.2px] hover:border-accent hover:border-[0.2px] min-w-[144px] transition-colors duration-200"
    >
        <span class="text-sm">Access Portal</span>
        <svg
            class="w-5"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path
                d="M11 9a1 1 0 0 0 1-1V5.061a1 1 0 0 1 1.811-.75l6.836 6.836a1.207 1.207 0 0 1 0 1.707l-6.836 6.835a1 1 0 0 1-1.811-.75V16a1 1 0 0 0-1-1H9a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1z"
            ></path>
            <path d="M4 9v6"></path>
        </svg>
    </button>

    <!-- Burger button — mobile only -->
    <button
        id="menu-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        class="flex w-auto pl-4 pr-6 h-auto justify-center items-center lg:hidden"
    >
        <div class="relative w-auto h-auto">
            <span
                id="burger-line-1"
                class="absolute top-1/2 left-0 -translate-y-1/2 w-7 h-[3px] bg-gray-300 rounded-full"
            ></span>
            <span
                id="burger-line-2"
                class="absolute top-1/2 left-0 -translate-y-1/2 w-7 h-[3px] bg-gray-300 rounded-full"
            ></span>
        </div>
    </button>
</nav>

<!-- Portal Modal -->
<PortalModal />

<!-- Mobile menu overlay — full screen, controlled by GSAP -->
<div
    id="mobile-menu"
    class="fixed inset-0 z-40 flex flex-col justify-between pb-4 bg-black-900 pt-20 overflow-hidden lg:hidden"
    style="clip-path: inset(0 0 100% 0); pointer-events: none;"
>
    <ul class="flex flex-col px-6 mt-4">
        <li class="mobile-menu-item">
            <a
                href="/#ecosystem"
                class="mobile-menu-link flex items-center justify-between py-5 w-full text-3xl font-bebas-neue text-gray-300 tracking-widest hover:text-accent transition-colors duration-200"
            >
                Ecosystem
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                    ></path></svg
                >
            </a>
        </li>
        <li class="mobile-menu-item">
            <a
                href="/#custody"
                class="mobile-menu-link flex items-center justify-between py-5 w-full text-3xl font-bebas-neue text-gray-300 tracking-widest hover:text-accent transition-colors duration-200"
            >
                Custody & Segregation
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
