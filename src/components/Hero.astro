---
import video1 from "../assets/Videos/video_1.mp4";
import video2 from "../assets/Videos/video_2.mp4";
import video3 from "../assets/Videos/video_3.mp4";
---

<header
  id="hero-header"
  class="sticky top-0 z-0 flex flex-col lg:flex-row justify-center items-center h-auto min-h-dvh xl:h-auto px-4 md:px-8 gap-8 lg:gap-32 pt-16 pb-8 lg:py-24"
>
  <!-- Text content block -->
  <article
    id="hero-left"
    class="flex flex-col w-full justify-center border-r-0"
  >
    <span
      id="hero-eyebrow"
      class="text-gray-400 text-sm flex gap-2 items-center"
      ><div class="w-2 h-2 bg-accent rounded-4xl"></div>INSTITUTIONAL BULLION
      INFRASTRUCTURE</span
    >
    <h1
      id="hero-h1"
      class="text-4xl md:text-5xl text-white-700 uppercase font-bebas-neue leading-tight lg:leading-14 font-medium mt-2"
    >
      An Independent Bullion Infrastructure for<br /><span class="text-accent">
        Professional Intermediaries</span
      >
    </h1>
    <p
      id="hero-p"
      class="text-gray-300 my-3 text-sm md:text-base w-full lg:w-2/3"
    >
      WiseGold Capital provides custody coordination, logistics, and transaction
      support through a global network of independent depositories and
      counterparties. Designed for intermediaries seeking structured, compliant,
      and scalable bullion solutions.
    </p>
    <a
      id="hero-cta"
      href="#intermediaries"
      class="hover:group flex items-center justify-between px-4 h-[50px] py-2 hover:bg-gray-900 hover:text-accent w-full md:w-fit md:gap-2 border-gray-500 border-2 hover:border-accent hover:border-2"
    >
      <span class="group-hover:text-accent text-white-700 text-xs md:text-base"
        >Request Platform Access</span
      >
      <svg
        class="w-5 text-white group-hover:text-accent"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path
          d="M11 9a1 1 0 0 0 1-1V5.061a1 1 0 0 1 1.811-.75l6.836 6.836a1.207 1.207 0 0 1 0 1.707l-6.836 6.835a1 1 0 0 1-1.811-.75V16a1 1 0 0 0-1-1H9a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1z"
        ></path><path d="M4 9v6"></path></svg
      >
    </a>
  </article>

  <!-- Right article: video + cards -->
  <article
    id="hero-right"
    class="relative z-10 w-full lg:w-2/3 h-auto gap-8 flex flex-col"
  >
    <span
      id="hero-right-label"
      class="text-white-700 text-sm flex gap-2 items-center"
      ><div class="w-2 h-2 bg-accent rounded-4xl"></div>Global Reach</span
    >
    <video
      id="hero-video-main"
      src={video1}
      autoplay
      muted
      loop
      playsinline
      class="w-full h-full object-cover border border-gray-500 rounded-2xl lg:rounded-4xl"
    ></video>
    <div
      id="hero-card-1"
      class="border border-gray-500 rounded-4xl p-4 gap-4 hidden md:flex md:justify-between lg:justify-start hover:bg-gray-900"
    >
      <p class="flex flex-col text-white-700 text-sm gap-3">
        A Structured Approach to Bullion Ownership and Custody<span class="text-gray-400 text-sm"
          >Client ownership is supported through independent custody arrangements, jurisdictional diversification, and operational infrastructure designed for long-term capital preservation.</span
        >
      </p>
      <video
        src={video2}
        autoplay
        muted
        loop
        playsinline
        class="w-20 md:w-auto lg:w-20 h-20 md:h-30 lg:h-40 object-cover rounded-2xl"
      ></video>
    </div>
    <!-- <div
      id="hero-card-2"
      class="border border-gray-500 rounded-2xl p-4 hidden md:flex md:justify-between lg:justify-start hover:bg-gray-900"
    >
      <p class="flex flex-col text-white-700 text-sm gap-3">
        Segregated Custody &amp; Compliance<span class="text-gray-400 text-sm"
          >Account-level segregation, independent vaults, and AML/CTF controls</span
        >
      </p>
      <video
        src={video3}
        autoplay
        muted
        loop
        playsinline
        class="w-20 h-20 object-cover rounded-lg md:w-auto md:h-30 lg:w-20 lg:h-20"
      ></video>
    </div> -->
  </article>
</header>
