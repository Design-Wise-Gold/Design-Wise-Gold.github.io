---
import video from "../assets/Videos/custody.mp4";
---

<section id="custody-trigger" class="w-full relative h-[300vh]">
    <div
        id="custody"
        class="sticky top-0 w-full h-screen flex flex-col items-center justify-center overflow-hidden bg-black-900"
    >
        <div
            class="custody-content flex flex-col items-center justify-center w-full h-full gap-6"
        >
            <article
                class="custody-text w-full flex flex-col lg:flex-row items-center justify-between gap-8 px-4 "
            >
                <div class="flex flex-col items-left justify-center gap-2 w-full">
                    <h2
                        class="text-4xl md:text-5xl font-medium text-white-700 uppercase font-bebas-neue leading-tight lg:leading-14 mt-2 text-left  w-full"
                    >
                        <span class="text-accent">Independent Custody</span> <br>and Structured Ownership
                    </h2>
                    <p
                        class="text-gray-300 text-base md:text-base text-left  w-full lg:w-4/5"
                    >
                        WiseGold Capital coordinates custody exclusively through
                        independent, approved depositories in recognized
                        jurisdictions.
                    </p>
                </div>
                <ul class="flex flex-col gap-4 text-sm items-left w-full    ">
                    <li class="flex items-center gap-3 text-gray-400 group"> <svg xmlns="http://www.w3.org/2000/svg" height="18" viewBox="0 -960 960 960" width="18" fill="currentColor" class="size-[18px] shrink-0"><path d="m390-80-68-120H190l-90-160 68-120-68-120 90-160h132l68-120h180l68 120h132l90 160-68 120 68 120-90 160H638L570-80H390Zm248-440h86l44-80-44-80h-86l-45 80 45 80ZM438-400h84l45-80-45-80h-84l-45 80 45 80Zm0-240h84l46-81-45-79h-86l-45 79 46 81ZM237-520h85l45-80-45-80h-85l-45 80 45 80Zm0 240h85l45-80-45-80h-86l-44 80 45 80Zm200 120h86l45-79-46-81h-84l-46 81 45 79Zm201-120h85l45-80-45-80h-85l-45 80 45 80Z"/></svg>
                        Client ownership remains fully backed by physical
                        bullion on an ounce-per-ounce basis
                    </li>
                    <li class="flex items-center gap-3 text-gray-400 group"> <svg xmlns="http://www.w3.org/2000/svg" height="18" viewBox="0 -960 960 960" width="18" fill="currentColor" class="size-[18px] shrink-0"><path d="m390-80-68-120H190l-90-160 68-120-68-120 90-160h132l68-120h180l68 120h132l90 160-68 120 68 120-90 160H638L570-80H390Zm248-440h86l44-80-44-80h-86l-45 80 45 80ZM438-400h84l45-80-45-80h-84l-45 80 45 80Zm0-240h84l46-81-45-79h-86l-45 79 46 81ZM237-520h85l45-80-45-80h-85l-45 80 45 80Zm0 240h85l45-80-45-80h-86l-44 80 45 80Zm200 120h86l45-79-46-81h-84l-46 81 45 79Zm201-120h85l45-80-45-80h-85l-45 80 45 80Z"/></svg>
                        Ownership is segregated through custody arrangements and
                        account-level records
                    </li>
                    <li class="flex items-center gap-3 text-gray-400 group"><svg xmlns="http://www.w3.org/2000/svg" height="18" viewBox="0 -960 960 960" width="18" fill="currentColor" class="size-[18px] shrink-0"><path d="m390-80-68-120H190l-90-160 68-120-68-120 90-160h132l68-120h180l68 120h132l90 160-68 120 68 120-90 160H638L570-80H390Zm248-440h86l44-80-44-80h-86l-45 80 45 80ZM438-400h84l45-80-45-80h-84l-45 80 45 80Zm0-240h84l46-81-45-79h-86l-45 79 46 81ZM237-520h85l45-80-45-80h-85l-45 80 45 80Zm0 240h85l45-80-45-80h-86l-44 80 45 80Zm200 120h86l45-79-46-81h-84l-46 81 45 79Zm201-120h85l45-80-45-80h-85l-45 80 45 80Z"/></svg>
                        No commingling with WiseGold Capital’s operating assets
                    </li>
                    <li class="flex items-center gap-3 text-gray-400 group"><svg xmlns="http://www.w3.org/2000/svg" height="18" viewBox="0 -960 960 960" width="18" fill="currentColor" class="size-[18px] shrink-0"><path d="m390-80-68-120H190l-90-160 68-120-68-120 90-160h132l68-120h180l68 120h132l90 160-68 120 68 120-90 160H638L570-80H390Zm248-440h86l44-80-44-80h-86l-45 80 45 80ZM438-400h84l45-80-45-80h-84l-45 80 45 80Zm0-240h84l46-81-45-79h-86l-45 79 46 81ZM237-520h85l45-80-45-80h-85l-45 80 45 80Zm0 240h85l45-80-45-80h-86l-44 80 45 80Zm200 120h86l45-79-46-81h-84l-46 81 45 79Zm201-120h85l45-80-45-80h-85l-45 80 45 80Z"/></svg>
                        No direct exposure to WiseGold Capital’s balance sheet
                    </li>
                </ul>
            </article>
            <article
                class="custody-video-wrapper w-full h-96 md:h-[55vh]  overflow-hidden shadow-2xl relative z-10 p-0 m-0"
            >
                <video
                    src={video}
                    autoplay
                    muted
                    loop
                    playsinline
                    class="custody-video w-full h-full object-cover opacity-100"
                >
                </video>
            </article>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const mm = gsap.matchMedia();

        mm.add("(min-width: 1px)", () => {
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: "#custody-trigger",
                    start: "top top",
                    end: "bottom bottom",
                    scrub: 1, // Smooth scrub
                },
            });

            // PHASE 1: Reveal & Expansion (0 to 1)
            tl.to(
                ".custody-text",
                {
                    opacity: 0,
                    y: -30,
                    height: 0,
                    padding: 0,
                    margin: 0,
                    duration: 1,
                    ease: "power2.inOut",
                },
                0,
            );

            tl.to(
                ".custody-content",
                {
                    gap: "0rem",
                    duration: 1,
                    ease: "power2.inOut",
                },
                0,
            );

            tl.to(
                ".custody-video-wrapper",
                {
                   
                    height: "100vh",
                    borderRadius: "0px",
                    duration: 1,
                    ease: "power2.inOut",
                },
                0,
            );

            // PHASE 2: Short Linger (1 to 1.3)
            // Just empty duration to "stay there" for a moment
            tl.to({}, { duration: 0.3 });

            // PHASE 3: Gradual Fade & Darken for Transition (1.3 to 2)
            tl.to(
                ".custody-video",
                {
                    opacity: 0.5,
                    duration: 0.5,
                    ease: "power1.inOut",
                },
                1.3,
            );

            tl.to(
                "#custody",
                {
                    opacity: 0,
                    scale: 0.98,
                    duration: 0.5,
                    ease: "power2.in",
                },
                1.3,
            );
        });
    });
</script>
