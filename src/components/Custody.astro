---
import video from "../assets/Videos/Intermediary.mp4";
---

<section
    id="custody"
    class="flex flex-col  gap-8 w-full px-4 py-10 max-h-dvh"
>    
            <article
                id="custody-header"
                class="custody-text w-full h-auto flex flex-col items-center justify-between gap-8"
            >
                <div id="custody-header-text" class="flex flex-col items-left justify-center gap-2 w-full h-auto">
                    <h2
                        class="text-4xl md:text-5xl font-medium text-white-700 uppercase font-bebas-neue leading-tight lg:leading-14 mt-2 text-left w-full"
                    >
                        <span class="text-accent">Independent Custody</span>
                        and Structured Ownership
                    </h2>
                    <p
                        class="text-gray-300 text-base md:text-base text-left w-full lg:w-4/5"
                    >
                        WiseGold Capital coordinates custody exclusively through
                        independent, approved depositories in recognized jurisdictions.
                    </p>
                </div>
                <ul
                    id="custody-cards"
                    class="flex flex-col lg:hidden gap-4 text-sm items-left w-full h-auto">
                    <li class="flex items-center gap-3 text-gray-400 group">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            height="18"
                            viewBox="0 -960 960 960"
                            width="18"
                            fill="currentColor"
                            class="size-[18px] shrink-0"
                            ><path
                                d="m390-80-68-120H190l-90-160 68-120-68-120 90-160h132l68-120h180l68 120h132l90 160-68 120 68 120-90 160H638L570-80H390Zm248-440h86l44-80-44-80h-86l-45 80 45 80ZM438-400h84l45-80-45-80h-84l-45 80 45 80Zm0-240h84l46-81-45-79h-86l-45 79 46 81ZM237-520h85l45-80-45-80h-85l-45 80 45 80Zm0 240h85l45-80-45-80h-86l-44 80 45 80Zm200 120h86l45-79-46-81h-84l-46 81 45 79Zm201-120h85l45-80-45-80h-85l-45 80 45 80Z"
                            ></path></svg
                        >
                        Client ownership backed by physical bullion ounce-per-ounce
                    </li>
                    <li class="flex items-center gap-3 text-gray-400 group">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            height="18"
                            viewBox="0 -960 960 960"
                            width="18"
                            fill="currentColor"
                            class="size-[18px] shrink-0"
                            ><path
                                d="m390-80-68-120H190l-90-160 68-120-68-120 90-160h132l68-120h180l68 120h132l90 160-68 120 68 120-90 160H638L570-80H390Zm248-440h86l44-80-44-80h-86l-45 80 45 80ZM438-400h84l45-80-45-80h-84l-45 80 45 80Zm0-240h84l46-81-45-79h-86l-45 79 46 81ZM237-520h85l45-80-45-80h-85l-45 80 45 80Zm0 240h85l45-80-45-80h-86l-44 80 45 80Zm200 120h86l45-79-46-81h-84l-46 81 45 79Zm201-120h85l45-80-45-80h-85l-45 80 45 80Z"
                            ></path></svg
                        >
                        Ownership segregated via custody and account-level records
                    </li>
                    <li class="flex items-center gap-3 text-gray-400 group">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            height="18"
                            viewBox="0 -960 960 960"
                            width="18"
                            fill="currentColor"
                            class="size-[18px] shrink-0"
                            ><path
                                d="m390-80-68-120H190l-90-160 68-120-68-120 90-160h132l68-120h180l68 120h132l90 160-68 120 68 120-90 160H638L570-80H390Zm248-440h86l44-80-44-80h-86l-45 80 45 80ZM438-400h84l45-80-45-80h-84l-45 80 45 80Zm0-240h84l46-81-45-79h-86l-45 79 46 81ZM237-520h85l45-80-45-80h-85l-45 80 45 80Zm0 240h85l45-80-45-80h-86l-44 80 45 80Zm200 120h86l45-79-46-81h-84l-46 81 45 79Zm201-120h85l45-80-45-80h-85l-45 80 45 80Z"
                            ></path></svg
                        >
                        No commingling with WiseGold Capital’s operating assets
                    </li>
                    <li class="flex items-center gap-3 text-gray-400 group">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            height="18"
                            viewBox="0 -960 960 960"
                            width="18"
                            fill="currentColor"
                            class="size-[18px] shrink-0"
                            ><path
                                d="m390-80-68-120H190l-90-160 68-120-68-120 90-160h132l68-120h180l68 120h132l90 160-68 120 68 120-90 160H638L570-80H390Zm248-440h86l44-80-44-80h-86l-45 80 45 80ZM438-400h84l45-80-45-80h-84l-45 80 45 80Zm0-240h84l46-81-45-79h-86l-45 79 46 81ZM237-520h85l45-80-45-80h-85l-45 80 45 80Zm0 240h85l45-80-45-80h-86l-44 80 45 80Zm200 120h86l45-79-46-81h-84l-46 81 45 79Zm201-120h85l45-80-45-80h-85l-45 80 45 80Z"
                            ></path></svg
                        >
                        No direct exposure to WiseGold Capital’s balance sheet
                    </li>
                </ul>
            </article>
            <article
                id="custody-video"
                class="w-full h-full lg:h-auto "
            >
                <video
                    src={video}
                    autoplay
                    muted
                    loop
                    playsinline
                    controls
                    class=" w-full  h-full lg:h-[500px] object-cover rounded-xl"
                >
                </video>
            </article>
        
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const section = document.querySelector("#custody");
        const headers = document.querySelectorAll("#custody-header h2, #custody-header p");
        const cards   = gsap.utils.toArray("#custody-cards > *");
        const video   = document.querySelector("#custody-video");

        if (!section || cards.length === 0 || !video) return;

        // Headers: entran suavemente al llegar la sección al viewport
        gsap.fromTo(
            headers,
            { opacity: 0, y: 24 },
            {
                opacity: 1,
                y: 0,
                stagger: 0.2,
                duration: 1.2,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: section,
                    start: "top 90%",
                    toggleActions: "play none none reverse",
                },
            },
        );

        // Cards: aparecen inmediatamente al entrar la sección —
        // sin pin, sin scrub, sin necesidad de scroll adicional
        gsap.fromTo(
            cards,
            { opacity: 0, y: 40 },
            {
                opacity: 1,
                y: 0,
                stagger: 0.15,
                duration: 1.4,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: section,
                    start: "top 85%",
                    toggleActions: "play none none reverse",
                },
            },
        );

        // Video: entra suavemente al llegar la sección al viewport
        gsap.fromTo(
            video,
            { opacity: 0, scale: 0.5 },
            {
                opacity: 1,
                scale: 1,
                duration: 1.2,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: video,
                    start: "top 90%",
                    toggleActions: "play none none reverse",
                },
            },
        );
    });
</script>


