---
import video from "../assets/Videos/custody.mp4";
---

<section id="custody-trigger" class="w-full relative h-[300vh]">
    <div
        id="custody"
        class="sticky top-0 w-full h-screen flex flex-col items-center justify-center overflow-hidden bg-black-900"
    >
        <div class="custody-content flex flex-col items-center justify-center w-full h-full gap-6">
            <article
                class="custody-text w-full flex flex-col items-center justify-center gap-2 px-4 flex-shrink-0"
            >
                <h2
                    class="text-4xl md:text-5xl font-medium text-white-700 uppercase font-bebas-neue leading-tight lg:leading-14 mt-2 text-left lg:text-center w-full"
                >
                    Institutional Grade Segregation & Custody Control
                </h2>
                <p
                    class="text-gray-300 lg:mt-3 text-sm md:text-base text-left lg:text-center w-full lg:w-2/3"
                >
                    A unified ecosystem encompassing advisory, independent vault
                    coordination, technology, and proprietary trading. Engineered
                    exclusively for capital preservation and institutional continuity
                </p>
            </article>
            <article class="custody-video-wrapper w-[92%] md:w-3/4 max-w-5xl h-96 md:h-[55vh] flex-shrink-0 overflow-hidden shadow-2xl relative z-10 p-0 m-0">
                <video
                    src={video}
                    autoplay
                    muted
                    loop
                    playsinline
                    class="custody-video w-full h-full object-cover opacity-100"
                >
                </video>
            </article>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const mm = gsap.matchMedia();

        mm.add("(min-width: 1px)", () => {
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: "#custody-trigger",
                    start: "top top",
                    end: "bottom bottom",
                    scrub: 1, // Smooth scrub
                }
            });

            // PHASE 1: Reveal & Expansion (0 to 1)
            tl.to(".custody-text", {
                opacity: 0,
                y: -30,
                height: 0,
                padding: 0,
                margin: 0,
                duration: 1,
                ease: "power2.inOut"
            }, 0);

            tl.to(".custody-content", {
                gap: "0rem",
                duration: 1,
                ease: "power2.inOut"
            }, 0);

            tl.to(".custody-video-wrapper", {
                width: "100%",
                maxWidth: "100%",
                height: "100vh",
                borderRadius: "0px",
                duration: 1,
                ease: "power2.inOut"
            }, 0);

            // PHASE 2: Short Linger (1 to 1.3)
            // Just empty duration to "stay there" for a moment
            tl.to({}, { duration: 0.3 });

            // PHASE 3: Gradual Fade & Darken for Transition (1.3 to 2)
            tl.to(".custody-video", {
                opacity: 0.5,
                duration: 0.5,
                ease: "power1.inOut"
            }, 1.3);

            tl.to("#custody", {
                opacity: 0,
                scale: 0.98,
                duration: 0.5,
                ease: "power2.in"
            }, 1.3);
        });
    });
</script>


