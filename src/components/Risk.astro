---
import Card__Risk from "./card__risk.astro";
import icon1 from "../assets/Icons/icon_1.svg";
import icon2 from "../assets/Icons/icon_2.svg";
import icon3 from "../assets/Icons/icon_3.svg";
import icon4 from "../assets/Icons/icon_4.svg";
import image1 from "../assets/Images/image_1.png";
import image2 from "../assets/Images/image_2.png";
import image3 from "../assets/Images/image_3.png";
import image4 from "../assets/Images/image_4.png";
---

<section
    id="risk"
    class="relative z-20 flex flex-col items-center justify-center h-full lg:py-24 w-full pt-8 pb-10 gap-6 bg-black-900"
>
    <article
        class="w-full h-auto flex flex-col items-center justify-center gap-2 px-4"
    >
        <h2
            class="text-4xl md:text-5xl font-medium text-white-700 uppercase font-bebas-neue leading-tight lg:leading-14 mt-2 text-left lg:text-center w-full"
        >
            Institutional Risk & <span class="text-accent">Governance Framework </span>
        </h2>
        <p
            class="text-gray-300 lg:mt-3 text-sm md:text-base text-left lg:text-center w-full lg:w-2/3"
        >
            Risk oversight, compliance monitoring, and operational controls are
            embedded across our ecosystem, providing intermediaries with the
            transparency and discipline required for long‑term capital
            preservation
        </p>
    </article>
    <article
        id="risk-cards"
        class="w-full flex flex-col lg:flex-row items-end px-4 justify-center gap-4 lg:min-h-[400px]"
    >
        <Card__Risk
            title="Governance Committees"
            description="Board‑level committees oversee risk, compliance, and operational integrity. Clear separation exists between executive functions and oversight roles"
            icon={icon1.src}
            image={image1.src}
        />
        <Card__Risk
            title="AML/CTF Framework"
            description="Comprehensive anti‑money laundering and counter‑terrorism financing protocols, including intermediary due diligence, transaction monitoring, and regulatory"
            icon={icon2.src}
            image={image2.src}
        />
        <Card__Risk
            title="Operational Controls"
            description="Daily position reconciliations, segregation verification, and independent audit trails maintain accuracy and transparency across custody and trading operations"
            icon={icon3.src}
            image={image3.src}
        />
        <Card__Risk
            title="Risk Oversight"
            description="Proprietary risk models and internal monitoring ensure market discipline without exposure to client assets. No client funds are held or traded"
            icon={icon4.src}
            image={image4.src}
        />
    </article>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const initRiskPinnedAnimation = () => {
            const riskSection = document.querySelector("#risk");
            const headers = document.querySelectorAll("#risk h2, #risk p");
            const cards = gsap.utils.toArray<HTMLElement>("#risk-cards > *");

            if (!riskSection || cards.length === 0) return;

            // Create a single unified pinned timeline for the whole section
            const mainTl = gsap.timeline({
                scrollTrigger: {
                    trigger: riskSection,
                    start: "top top",
                    pin: true,     // Section stays pinned while cards reveal
                    scrub: 1,      // Tied to scroll progress
                    invalidateOnRefresh: true
                }
            });

            // PHASE 1: Headers entrance (0 to 0.5)
            mainTl.fromTo(headers, 
                { opacity: 0, y: 30 },
                { opacity: 1, y: 0, stagger: 0.1, duration: 0.5, ease: "power2.out" },
                0
            );

            // PHASE 2: Sequential Card Reveal (One by One)
            // We use overlapping labels/offsets to ensure a "one by one" wave
            cards.forEach((card, i) => {
                const startTime = 0.4 + (i * 0.4); // Staggered start times
                
                mainTl.fromTo(card,
                    { 
                        opacity: 0, 
                        y: 150 // Deep offset for parallax arrival
                    },
                    { 
                        opacity: 1, 
                        y: 0, 
                        duration: 0.6,
                        ease: "power2.out" 
                    },
                    startTime
                );
            });

            // PHASE 3: Brief hold at the end for the last card (to avoid cutting off)
            mainTl.to({}, { duration: 0.5 }); // Final pause at 100% visible

            ScrollTrigger.refresh();
        };

        initRiskPinnedAnimation();
        
        // Safety refresh for complex layouts
        window.addEventListener("load", () => ScrollTrigger.refresh());
        setTimeout(() => ScrollTrigger.refresh(), 1000);
    });
</script>

