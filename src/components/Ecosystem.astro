---
import Card__ecosystem from "./card__ecosystem.astro";
import video4 from "../assets/Videos/video_4.mp4";
import video5 from "../assets/Videos/video_5.mp4";
import video6 from "../assets/Videos/video_6.mp4";
import video7 from "../assets/Videos/video_7.mp4";
---

<section
    id="ecosystem"
    class="bg-black-900 flex flex-col-reverse lg:flex-row items-start lg:items-center justify-center h-auto lg:min-h-dvh w-full border-solid border-gray-500 border-t-[0.2px]  gap-4 lg:gap-8 lg:py-12 relative z-10"
>
    <article
        id="ecosystem-left"
        class="w-full lg:w-1/2 grid items-center lg:*:col-start-1 lg:*:row-start-1 relative lg:min-h-[500px] gap-4 lg:gap-0"
    >
        <Card__ecosystem
            title="Advisory"
            description="Strategic guidance supporting intermediaries in structuring bullion holdings across jurisdictions, inventory models, and client objectives"
            video={video4}
        />
        <Card__ecosystem
            title="Vault"
            description="Coordination of custody through independent depositories, supported by account-level records, logistics, and reporting systems"
            video={video5}
        />
        <Card__ecosystem
            title="Technology"
            description="Operational infrastructure enabling onboarding, reporting, reconciliation, and system-based control of bullion positions"
            video={video6}
        />
        <Card__ecosystem
            title="Proprietary Trading"
            description="Proprietary trading activities, where conducted, are undertaken solely for the account of WiseGold Capital, LLC and form part of its internal treasury operations. This division supports liquidity within the platform’s ecosystem and operates independently of client-related functions. Such activities do not involve, reference, or rely upon client assets, custody holdings, or inventory positions"
            video={video7}
        />
    </article>
    <article
        id="ecosystem-right"
        class="w-full lg:w-1/2 h-auto pt-3 flex flex-col items-center lg:items-right px-4 justify-end "
    >
        <h2
            id="eco-h2"
            class="text-4xl md:text-5xl font-medium text-white-700 uppercase font-bebas-neue leading-tight lg:leading-14 mt-2 text-left lg:text-right w-full"
        >
            The WiseGold Platform<br />
            <span class="text-accent">Ecosystem Architecture</span>
        </h2>
        <p
            id="eco-p"
            class="text-gray-300 lg:mt-3 text-sm md:text-base text-left lg:text-right w-full"
        >
            WiseGold Capital operates as a unified platform with four internal divisions
        </p>
    </article>
</section>
