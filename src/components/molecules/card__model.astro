---
const { number,title, description, item1, item2, item3, item4 } = Astro.props;
---

<div
    class=" flex flex-col items-center justify-center border border-gray-500 w-full h-auto lg:h-full transition-all duration-500 ease-in-out hover:bg-black-700 p-4 "
>
    <div
        class="group flex flex-col border border-gray-500 text-gray-300 w-full h-full justify-center  gap-3 lg:gap-4   hover:border-accent p-4"
    >
    <p class="text-gray-500 text-2xl md:text-6xl font-semibold w-full text-left font-bebas-neue">{number}</p>
        <h3
            class="text-white-700 group-hover:text-accent text-sm lg:text-base font-semibold w-full text-left  transition-all duration-500 tracking-wider"
        >
            {title}
        </h3>


        <p
            class="text-gray-400 group-hover:text-gray-200 mb-2 text-base text-left  w-full transition-colors duration-500 line-clamp-4 group-hover:line-clamp-none"
        >
            {description}
        </p>

        <ul class="text-gray-400 text-xs md:text-base list-disc list-inside">
            <li>{item1}</li>
            <li>{item2}</li>
            <li>{item3}</li>
            <li>{item4}</li>
        </ul>
    </div>
</div>
