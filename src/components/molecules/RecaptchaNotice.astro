---
// Componente de alerta para notificar el uso de reCAPTCHA
---

<div id="recaptcha-notice" class="fixed bottom-6 lg:bottom-12 left-0 lg:left-44 w-full lg:w-2/5 px-2 bg-gray-900 border border-gray-500 p-2 shadow-lg z-50 animate-fade-in">
    <div class="flex items-start justify-between gap-3">
        <div class="flex-1">
            <p class="text-xs text-gray-300 leading-relaxed">
                This site is protected by reCAPTCHA and the Google
                <a href="https://policies.google.com/privacy" target="_blank" class="text-white-700 hover:underline">Privacy Policy</a>
                and
                <a href="https://policies.google.com/terms" target="_blank" class="text-white-700 hover:underline">Terms of Service</a>
                apply.
            </p>
        </div>
        <button 
            id="close-recaptcha-notice"
            aria-label="Close reCAPTCHA notice"
            class="text-gray-400 hover:text-white transition-colors"
        >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const notice = document.getElementById("recaptcha-notice");
        const closeBtn = document.getElementById("close-recaptcha-notice");

        if (closeBtn) {
            closeBtn.addEventListener("click", () => {
                notice?.classList.add("animate-fade-out");
                setTimeout(() => {
                    notice?.remove();
                }, 300);
            });
        }
    });
</script>

<style>
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeOut {
        from {
            opacity: 1;
            transform: translateY(0);
        }
        to {
            opacity: 0;
            transform: translateY(20px);
        }
    }

    .animate-fade-in {
        animation: fadeIn 0.3s ease-out;
    }

    .animate-fade-out {
        animation: fadeOut 0.3s ease-out forwards;
    }
</style>
