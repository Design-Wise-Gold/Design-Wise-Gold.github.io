---
const { title, description, item1, item2, item3, item4, icon } = Astro.props;
---

<div
    class="flex flex-col items-center justify-center w-full h-auto lg:h-full transition-all duration-500 ease-in-out hover:bg-black-700 lg:p-4 border border-gray-500 p-2"
>
    <div
        class="group flex flex-col w-full h-full justify-left items-left gap-3 lg:gap-4 transition-transform duration-500 hover:border-accent"
    >
        <div
            class="w-8 h-8 lg:w-12 lg:h-12 bg-gray-400 group-hover:bg-gray-300 transition-colors duration-300"
            style={`-webkit-mask: url(${icon}) no-repeat center; mask: url(${icon}) no-repeat center; -webkit-mask-size: contain; mask-size: contain;`}
        >
        </div>

        <h3
            class="text-white-700 group-hover:text-accent text-sm lg:text-base font-semibold w-full text-left transition-all duration-500 tracking-wider"
        >
            {title}
        </h3>

        <p
            class="text-gray-400 group-hover:text-gray-200 mb-2 text-base text-left w-full transition-colors duration-500 line-clamp-4 group-hover:line-clamp-none"
        >
            {description}
        </p>

        <ul class="text-gray-400 text-sm space-y-1.5 list-disc list-inside">
            <li>{item1}</li>
            <li>{item2}</li>
            <li>{item3}</li>
            <li>{item4}</li>
        </ul>
    </div>
</div>
