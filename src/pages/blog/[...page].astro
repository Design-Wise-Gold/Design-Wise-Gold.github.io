---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/navbar.astro';
import Footer from '../../components/Footer.astro';
import type { Page, GetStaticPaths } from 'astro';
import { fetchPosts } from '../../lib/blog';
import type { Post } from '../../lib/blog';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await fetchPosts();
  return paginate(posts, { pageSize: 7 });
};

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const posts = page.data;

// ── Build Schema.org ItemList for rich results ────────────────────────────────
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'WiseGold Weekly Pulse — Blog',
  description: 'Weekly insights on gold markets, institutional asset allocation, and macro finance.',
  url: 'https://wise.gold/blog/',
  itemListElement: posts.map((post: Post, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: post.title,
    url: `https://wise.gold${post.internalUrl}`,
  })),
};
---

<Layout
  title="WiseGold Blog — Weekly Pulse | Gold Market Insights"
  description="Follow WiseGold's weekly insights on gold markets, institutional asset allocation, and the structural themes rewriting the rules of modern finance."
  canonical="https://wise.gold/blog/"
  ogType="website"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />

  <Navbar />

  <main class="block mx-3 lg:mx-[143px] border-solid border-gray-500 border-l-[0.2px] border-r-[0.2px]">

    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="px-4 md:px-12 pt-16 lg:pt-16">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-gray-400" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" class="hover:text-accent transition-colors" itemprop="item">
            <span itemprop="name">Home</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="text-gray-600" aria-hidden="true">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
          <span class="text-gray-300" itemprop="name">Blog</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <section class="flex flex-col justify-center items-center text-center px-4 md:px-12 pb-4 lg:pb-16 pt-8 lg:pt-16 border-b-[0.2px] border-gray-500">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bebas-neue text-gray-100 tracking mb-6">
        WiseGold Blog
      </h1>
      <p class="text-accent text-2xl mb-3">Weekly Pulse</p>
      <p class="text-base text-gray-300 max-w-4xl font-light leading-relaxed">
        Insights, market intelligence, and structural themes rewriting the rules of asset allocation.
      </p>
    </section>

    <!-- Posts -->
    <section class="py-16 px-4 lg:px-16 md:px-12 flex flex-col gap-8" aria-label="Blog articles">

      {posts.length === 0 && (
        <p class="text-gray-400 text-center py-20">
          No articles available right now. Check back soon.
        </p>
      )}

      {posts.map((post: Post, index: number) => {
        const dateISO = post.date ? new Date(post.date).toISOString() : '';
        const dateDisplay = post.date
          ? new Date(post.date).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          : '';

        return (
          <article
            class="flex flex-col lg:flex-row gap-4 lg:gap-12 group pb-8"
            aria-label={post.title}
          >
            <div class="flex justify-start overflow-hidden h-fit items-start w-1/2 lg:w-1/6 border-[0.2px] border-gray-500">
              <a href={post.internalUrl} class="block w-full h-full">
                <img
                  src={post.image ?? '/images/fallback.jpg'}
                  alt={post.title}
                  width="320"
                  height="180"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  class="w-full h-auto max-h-[150px] object-cover transition-transform duration-700 group-hover:scale-105"
                />
              </a>
            </div>

            <!-- Contenido -->
            <div class="w-full flex flex-col justify-center gap-2 min-w-0">
              <time
                datetime={dateISO}
                class="text-gray-400 text-xs uppercase"
              >
                {dateDisplay}
              </time>

              <a href={post.internalUrl}>
                <h2 class="text-lg md:text-3xl text-[#ffffffc5] leading-snug hover:text-white transition-colors duration-300 font-semibold">
                  {post.title}
                </h2>
              </a>

              <p class="text-gray-400 leading-relaxed text-sm md:text-base">
                {post.excerpt}
              </p>

              <a
                href={post.internalUrl}
                aria-label={`Read full article: ${post.title}`}
                class="text-gray-300 flex justify-center items-center gap-2 mt-4 py-2 w-fit group-hover:text-white transition text-sm md:text-base"
              >
                Read Full Article<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="m256-240-56-56 384-384H240v-80h480v480h-80v-344L256-240Z"/></svg>
              </a>
            </div>
          </article>
        );
      })}

      <!-- Pagination Controls -->
      {page.lastPage > 1 && (
        <nav class="flex justify-center items-center gap-4 mt-12 mb-8" aria-label="Pagination">
          {page.url.prev ? (
            <a
              href={page.url.prev}
              class="text-gray-400 hover:text-white transition-colors flex items-center gap-2"
            >
              <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="m313-440 224 224-57 57-320-320 320-320 57 57-224 224h487v80H313Z"/></svg>
              Previous
            </a>
          ) : (
            <span class="text-black-900 flex items-center gap-2 cursor-not-allowed">
              <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="m313-440 224 224-57 57-320-320 320-320 57 57-224 224h487v80H313Z"/></svg>
              Previous
            </span>
          )}

          <div class="flex gap-2">
            {[...Array(page.lastPage)].map((_, i) => {
              const pageNum = i + 1;
              const url = pageNum === 1 ? '/blog' : `/blog/${pageNum}`;
              return (
                <a
                  href={url}
                  class={`w-8 h-8 flex items-center justify-center rounded-sm border-[0.2px] transition-colors ${
                    page.currentPage === pageNum
                      ? 'bg-accent text-black border-accent'
                      : 'border-gray-500 text-gray-400 hover:border-white hover:text-white'
                  }`}
                >
                  {pageNum}
                </a>
              );
            })}
          </div>

          {page.url.next ? (
            <a
              href={page.url.next}
              class="text-gray-400 hover:text-white transition-colors flex items-center gap-2"
            >
              Next
              <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="M647-440H160v-80h487L423-744l57-57 320 320-320 320-57-57 224-224Z"/></svg>
            </a>
          ) : (
            <span class="text-black-900 flex items-center gap-2 cursor-not-allowed">
              Next
              <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="M647-440H160v-80h487L423-744l57-57 320 320-320 320-57-57 224-224Z"/></svg>
            </span>
          )}
        </nav>
      )}

    </section>

  </main>

  <Footer class="border-t-[0.2px] border-gray-500" />
</Layout>
