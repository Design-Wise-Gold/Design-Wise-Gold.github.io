---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Error404 from "../assets/Icons/404.svg";
--- 

<Layout

  title="404 - Page Not Found — WiseGold Capital"
  description="The page you are looking for does not exist."
  canonical="https://wise.gold/404"
  noindex={true}
>
    
    <main
        class="flex flex-col justify-center items-center text-center p-4 w-full min-h-screen"
    >
    <img src={Error404.src} alt="WiseGold Capital - Error 404 Page Not Found" class="w-1/4 h-auto">
        
        <p class="text-gray-400 text-lg mb-10 max-w-lg">
           404 - The page you are looking for might have been removed, had its name changed, or is temporarily unavailable. 
        </p>
        <a 
            href="/"
            class="px-6 py-3 border border-yellow-500 text-yellow-500 hover:bg-yellow-500 hover:text-black transition-colors duration-300 font-semibold"
        >
            Return to Homepage
        </a>
    </main>
    <Footer class="border-t-[0.2px] border-gray-500"/>
</Layout>
