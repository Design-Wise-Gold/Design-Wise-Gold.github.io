---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/navbar.astro";
import Footer from "../components/Footer.astro";
import EmailObfuscator from "../components/molecules/EmailObfuscator.astro";
---

<Layout
  title="Privacy Policy — WiseGold Capital"
  description="WiseGold Capital's Privacy Policy. Learn how we collect, use, and protect your information in compliance with applicable data protection standards."
  canonical="https://wise.gold/privacy"
  noindex={true}
>
    <Navbar />
    <main
        class="block mx-3 lg:mx-[143px] border-solid border-gray-500 border-l-[0.2px] border-r-[0.2px] px-6 lg:px-16 pt-32 pb-24"
    >
        <h1
            class="text-5xl md:text-6xl lg:text-7xl font-bebas-neue text-white-700 tracking-wide mb-2"
        >
            Privacy Policy
        </h1>
        <p class="text-gray-500 text-sm mb-16">WiseGold Capital, LLC — Effective Date: April 11, 2026</p>

        <div class="flex flex-col gap-10 max-w-3xl">

            <!-- 1 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    1. Overview
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed mb-2">
                    WiseGold Capital, LLC ("WiseGold Capital," "Company," "we," or "us") is committed to protecting the privacy of users of this website.
                </p>
                <p class="text-gray-300 text-sm leading-relaxed">
                    This Privacy Policy describes how information is collected, used, and maintained.
                </p>
            </section>

            <!-- 2 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    2. Information Collected
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed mb-3">
                    We may collect the following types of information:
                </p>

                <p class="text-white-700 text-sm font-semibold mb-2">Information You Provide</p>
                <ul class="list-disc list-inside text-gray-400 text-sm flex flex-col gap-1 mb-5">
                    <li>Name</li>
                    <li>Email address</li>
                    <li>Contact details</li>
                    <li>Information submitted through forms</li>
                </ul>

                <p class="text-white-700 text-sm font-semibold mb-2">Automatically Collected Information</p>
                <ul class="list-disc list-inside text-gray-400 text-sm flex flex-col gap-1">
                    <li>IP address</li>
                    <li>Browser type</li>
                    <li>Device information</li>
                    <li>Website usage data</li>
                </ul>
            </section>

            <!-- 3 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    3. Use of Information
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed mb-3">
                    Collected information may be used to:
                </p>
                <ul class="list-disc list-inside text-gray-400 text-sm flex flex-col gap-1 mb-3">
                    <li>Respond to inquiries</li>
                    <li>Provide requested information</li>
                    <li>Improve website functionality</li>
                    <li>Maintain security and integrity of systems</li>
                </ul>
                <p class="text-gray-300 text-sm leading-relaxed">
                    We do not use website data for unsolicited marketing.
                </p>
            </section>

            <!-- 4 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    4. Sharing of Information
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed mb-3">
                    WiseGold Capital does not sell or rent personal information. Information may be shared:
                </p>
                <ul class="list-disc list-inside text-gray-400 text-sm flex flex-col gap-1">
                    <li>With service providers supporting website operations</li>
                    <li>When required by law or regulation</li>
                    <li>To protect the rights and security of the Company</li>
                </ul>
            </section>

            <!-- 5 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    5. Data Protection
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed mb-2">
                    We implement reasonable administrative and technical measures to protect information.
                </p>
                <p class="text-gray-300 text-sm leading-relaxed">
                    However, no system can guarantee absolute security.
                </p>
            </section>

            <!-- 6 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    6. Cookies and Tracking
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed mb-3">
                    This website may use cookies or similar technologies to:
                </p>
                <ul class="list-disc list-inside text-gray-400 text-sm flex flex-col gap-1 mb-3">
                    <li>Enhance user experience</li>
                    <li>Analyze website usage</li>
                </ul>
                <p class="text-gray-300 text-sm leading-relaxed">
                    Users may adjust browser settings to decline cookies.
                </p>
            </section>

            <!-- 7 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    7. Third-Party Links
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed mb-2">
                    This website may contain links to third-party websites.
                </p>
                <p class="text-gray-300 text-sm leading-relaxed">
                    WiseGold Capital is not responsible for the privacy practices of such websites.
                </p>
            </section>

            <!-- 8 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    8. Data Retention
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                    Information is retained only as long as necessary for operational or legal purposes.
                </p>
            </section>

            <!-- 9 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    9. Your Rights
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed mb-3">
                    Depending on applicable law, users may have rights to:
                </p>
                <ul class="list-disc list-inside text-gray-400 text-sm flex flex-col gap-1 mb-3">
                    <li>Access personal data</li>
                    <li>Request corrections</li>
                    <li>Request deletion</li>
                </ul>
                <p class="text-gray-300 text-sm leading-relaxed">
                    Requests may be directed to the contact below.
                </p>
            </section>

            <!-- 10 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    10. Changes to Policy
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                    This Privacy Policy may be updated from time to time. Continued use of the website after changes constitutes acceptance of the revised policy.
                </p>
            </section>

            <!-- 11 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    11. Contact
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                    WiseGold Capital, LLC
                </p>
                <p class="text-gray-400 text-sm leading-relaxed">
                    400 N Ashley Dr Ste 1900, Tampa, FL 33543, USA
                </p> 
                <p class="text-gray-400 text-sm leading-relaxed">
                    <EmailObfuscator user="privacy" domain="wise.gold" className="text-accent hover:underline" />
                </p>
            </section>

        </div>
    </main>
    <Footer class="border-t-[0.2px] border-gray-500" />
</Layout>