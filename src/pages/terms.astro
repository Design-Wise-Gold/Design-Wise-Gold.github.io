---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/navbar.astro";
import Footer from "../components/Footer.astro";
import EmailObfuscator from "../components/molecules/EmailObfuscator.astro";
---

<Layout
  title="Terms and Conditions — WiseGold Capital"
  description="Terms of Use for WiseGold Capital, LLC. Read about our informational purpose, services scope, jurisdictional limitations, and governing law."
  canonical="https://wise.gold/terms/"
  noindex={true}
>
    <Navbar />
    <main
        class="block mx-3 lg:mx-[143px] border-solid border-gray-500 border-l-[0.2px] border-r-[0.2px] px-6 lg:px-16 pt-32 pb-24"
    >
        <h1
            class="text-5xl md:text-6xl lg:text-7xl font-bebas-neue text-white-700 tracking-wide mb-2"
        >
            Terms and Conditions
        </h1>
        <p class="text-gray-500 text-sm mb-16">WiseGold Capital, LLC — Effective Date: April 11, 2026</p>

        <div class="flex flex-col gap-10 max-w-3xl">

            <!-- 1 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    1. General Information
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                    This website is operated by WiseGold Capital, LLC ("WiseGold Capital," "Company," "we," or "us"), a Florida limited liability company. By accessing or using this website, you agree to be bound by these Terms of Use.
                </p>
            </section>

            <!-- 2 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    2. Informational Purpose Only
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed mb-3">
                    The information provided on this website is for informational purposes only. Nothing contained herein constitutes:
                </p>
                <ul class="list-disc list-inside text-gray-400 text-sm flex flex-col gap-1 mb-3">
                    <li>An offer to sell</li>
                    <li>A solicitation to buy</li>
                    <li>Investment, legal, or tax advice</li>
                </ul>
                <p class="text-gray-300 text-sm leading-relaxed">
                    Users should not rely on the content of this website as the basis for any decision.
                </p>
            </section>

            <!-- 3 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    3. No Client Relationship
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed mb-3">
                    Accessing this website does not establish:
                </p>
                <ul class="list-disc list-inside text-gray-400 text-sm flex flex-col gap-1 mb-3">
                    <li>A client relationship</li>
                    <li>An advisory relationship</li>
                    <li>Any fiduciary duty</li>
                </ul>
                <p class="text-gray-300 text-sm leading-relaxed">
                    All services are provided exclusively through approved intermediaries and are subject to separate written agreements.
                </p>
            </section>

            <!-- 4 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    4. Nature of Services
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed mb-3">
                    WiseGold Capital operates as an infrastructure platform providing:
                </p>
                <ul class="list-disc list-inside text-gray-400 text-sm flex flex-col gap-1 mb-4">
                    <li>Custody coordination</li>
                    <li>Logistics and operational support</li>
                    <li>Transaction coordination through approved counterparties</li>
                </ul>
                <p class="text-gray-300 text-sm leading-relaxed mb-3">
                    WiseGold Capital does not:
                </p>
                <ul class="list-disc list-inside text-gray-400 text-sm flex flex-col gap-1">
                    <li>Act as a bank or deposit-taking institution</li>
                    <li>Act as a physical custodian</li>
                    <li>Provide investment advice or portfolio management</li>
                    <li>Act as a broker-dealer</li>
                    <li>Act as a lender</li>
                </ul>
            </section>

            <!-- 5 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    5. Intermediary-Only Model
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                    Services described on this website are available exclusively through approved intermediaries. WiseGold Capital does not engage directly with members of the general public.
                </p>
            </section>

            <!-- 6 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    6. Jurisdictional Limitations
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                    The availability of services may be restricted in certain jurisdictions. Users are responsible for ensuring compliance with applicable local laws and regulations.
                </p>
            </section>

            <!-- 7 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    7. Risk Disclosure
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed mb-3">
                    Engagement with bullion-related activities involves risks, including but not limited to:
                </p>
                <ul class="list-disc list-inside text-gray-400 text-sm flex flex-col gap-1 mb-3">
                    <li>Market price volatility</li>
                    <li>Liquidity considerations</li>
                    <li>Counterparty risk</li>
                    <li>Jurisdictional and regulatory differences</li>
                </ul>
                <p class="text-gray-300 text-sm leading-relaxed">
                    All activities are subject to applicable agreements and governing terms.
                </p>
            </section>

            <!-- 8 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    8. Limitation of Liability
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed mb-3">
                    To the fullest extent permitted by law, WiseGold Capital shall not be liable for:
                </p>
                <ul class="list-disc list-inside text-gray-400 text-sm flex flex-col gap-1 mb-3">
                    <li>Any direct or indirect damages</li>
                    <li>Losses arising from reliance on website content</li>
                    <li>Interruptions or inaccuracies in information</li>
                </ul>
                <p class="text-gray-300 text-sm leading-relaxed">
                    Use of this website is at the user's own risk.
                </p>
            </section>

            <!-- 9 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    9. Intellectual Property
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                    All content on this website, including text, structure, systems, and design, is the property of WiseGold Capital, LLC. No content may be reproduced, distributed, or used without prior written consent.
                </p>
            </section>

            <!-- 10 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    10. Third-Party Relationships
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                    This website may reference third-party counterparties, depositories, or service providers. WiseGold Capital does not control and is not responsible for third-party services or content.
                </p>
            </section>

            <!-- 11 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    11. Modifications
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                    WiseGold Capital reserves the right to modify these Terms of Use at any time without prior notice.
                </p>
            </section>

            <!-- 12 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    12. Governing Law
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                    These Terms of Use shall be governed by the laws of the State of Florida.
                </p>
            </section>

            <!-- 13 -->
            <section>
                <h3 class="text-white-700 font-bebas-neue text-2xl tracking-wide mb-2">
                    13. Contact
                </h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                    WiseGold Capital, LLC
                </p>
                <p class="text-gray-400 text-sm leading-relaxed">
                    400 N Ashley Dr Ste 1900, Tampa, FL 33543, USA
                </p>
                <p class="text-gray-400 text-sm leading-relaxed">
                    <EmailObfuscator user="web" domain="wise.gold" className="text-accent hover:underline" />
                </p>
            </section>

        </div>
    </main>
    <Footer class="border-t-[0.2px] border-gray-500"/>
</Layout>
